{
  "name": "summon",
  "version": "0.1.0",
  "description": "Composable agent framework with portable YAML definitions",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "summon": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "dev": "bun --watch run src/cli/index.ts",
    "summon": "bun run src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "postinstall": "echo '\\n✓ Run: bun link\\n  Then use: summon --help\\n'"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.12",
    "@langchain/core": "^1.1.17",
    "@langchain/exa": "^0.1.0",
    "@langchain/google-genai": "^2.1.13",
    "@langchain/ollama": "^1.2.1",
    "@langchain/openai": "^1.2.3",
    "@langchain/tavily": "^1.2.0",
    "commander": "^13.1.0",
    "dotenv": "^17.2.3",
    "yaml": "^2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3"
  }
}
